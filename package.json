{
	"name": "portfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "panda codegen && husky",
		"dev": "pnpm run dev:servers",
		"dev:frontend": "vite",
		"start": "pnpm exec wrangler dev --remote",
		"dev:servers": "bash -lc 'pnpm run dev:frontend & pnpm run start & wait'",
		"prestart": "pnpm run generate:articles",
		"sync:atcoder": "node scripts/sync-atcoder-rate.mjs",
		"generate:articles": "pnpm exec tsx worker/lib/generate-blog.ts",
		"prebuild": "pnpm run generate:articles",
		"build": "tsc -b && vite build",
		"lint": "biome lint .",
		"preview": "pnpm run build && vite preview",
		"predeploy": "pnpm run generate:articles",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"check": "biome check --write"
	},
	"dependencies": {
		"chart.js": "^4.5.1",
		"highlight.js": "^11.12.0",
		"hono": "^4.13.13",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.5.0",
		"react-router": "^7.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@cloudflare/vite-plugin": "^1.64.0",
		"@pandacss/dev": "^1.3.0",
		"@types/jsdom": "^30.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"dompurify": "^3.4.17",
		"fast-glob": "^3.3.3",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"markdown-it": "^15.0.3",
		"tsx": "^4.23.15",
		"typescript": "~5.8.3",
		"vite": "^7.1.2",
		"wrangler": "^4.151.1"
	}
}
